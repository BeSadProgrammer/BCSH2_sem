<Window x:Class="StromApp.Views.RegionyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seznam regionů" Height="400" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ListView for Regiony -->
        <ListView ItemsSource="{Binding Regiony}" SelectedItem="{Binding SelectedRegion}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ID}" />
                    <GridViewColumn Header="Název regionu" DisplayMemberBinding="{Binding NazevRegionu}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Actions StackPanel -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5" Grid.Row="1">
            <Button Content="Přidat region" Command="{Binding ShowAddRegionDialogCommand}" Margin="5" Width="125" />
            <Button Content="Upravit region" Command="{Binding ShowEditRegionDialogCommand}" Margin="5" Width="125" />
            <Button Content="Odebrat region" Command="{Binding DeleteRegionCommand}" Margin="5" Width="125" />
            <Button Content="Zavřít" Command="{Binding CloseWindowCommand}" Margin="5" Width="80" />
        </StackPanel>
    </Grid>
</Window>
