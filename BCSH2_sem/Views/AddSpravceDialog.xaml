<Window x:Class="StromApp.Views.AddSpravceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Přidat správce" Height="400" Width="400" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Jméno -->
        <TextBlock Text="Zadejte jméno:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5"/>
        <TextBox x:Name="NameTextBox" Width="300" Margin="0,5" Grid.Row="1" Text="{Binding Name}" />

        <!-- Příjmení -->
        <TextBlock Text="Zadejte příjmení:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5" Grid.Row="2"/>
        <TextBox x:Name="SurnameTextBox" Width="300" Margin="0,5" Grid.Row="3" Text="{Binding Surname}" />

        <!-- E-mail -->
        <TextBlock Text="Zadejte e-mail:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5" Grid.Row="4"/>
        <TextBox x:Name="EmailTextBox" Width="300" Margin="0,5" Grid.Row="5" Text="{Binding Email}" />

        <!-- Telefon -->
        <TextBlock Text="Zadejte telefon:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5" Grid.Row="6"/>
        <TextBox x:Name="PhoneTextBox" Width="300" Margin="0,5" Grid.Row="7" Text="{Binding Phone}" />

        <!-- Region -->
        <TextBlock Text="Vyberte region:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5" Grid.Row="8"/>
        <ComboBox x:Name="RegionComboBox" Width="300" Margin="0,5" Grid.Row="9" ItemsSource="{Binding Regiony}" DisplayMemberPath="NazevRegionu" SelectedItem="{Binding SelectedRegion}" />

        <!-- Tlačítka pro Přidat a Zrušit -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="10" Margin="0,10">
            <Button Content="Přidat" Width="100" Command="{Binding AddSpravceCommand}" Margin="5"/>
            <Button Content="Zrušit" Width="100" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
