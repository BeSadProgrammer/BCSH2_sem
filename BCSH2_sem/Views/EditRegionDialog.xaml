<Window x:Class="StromApp.Views.EditRegionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upravit region" Height="200" Width="400" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zadejte název regionu" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10"/>
        <TextBox x:Name="RegionNameTextBox" Width="300" Margin="10" Grid.Row="1"
                 Text="{Binding RegionName, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="10">
            <Button Content="Upravit" Width="100" Command="{Binding EditRegionCommand}" Margin="5"/>
            <Button Content="Zrušit" Width="100" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
